        <mxCell id="note2" value="Зона ответственности колонки = один экран. ViewModel не знает про Retrofit, Room и TFLite. UseCase не знает про Context. Экран обращается только к domain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="180" y="815" width="2148" height="44" as="geometry" /></mxCell>
