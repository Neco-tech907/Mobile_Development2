        <mxCell id="c1a" value="&lt;b&gt;AuthRepositoryImpl&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;сейчас: тестовый пользователь&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;потом: SharedPreferences&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="192" y="540" width="228" height="230" as="geometry" /></mxCell>
        <mxCell id="c2p" value="&lt;b&gt;RecognizeFragment&lt;/b&gt;&lt;br&gt;&lt;b&gt;RecognizeViewModel&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;камера / галерея, превью&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="464" y="132" width="228" height="110" as="geometry" /></mxCell>
        <mxCell id="c2d" value="&lt;b&gt;UseCase&lt;/b&gt;&lt;br&gt;RecognizeBreedUseCase&lt;br&gt;&lt;br&gt;&lt;b&gt;Entity&lt;/b&gt;&lt;br&gt;Breed · RecognitionResult&lt;br&gt;&lt;br&gt;&lt;b&gt;Repository (интерфейс)&lt;/b&gt;&lt;br&gt;BreedRecognitionRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="464" y="258" width="228" height="250" as="geometry" /></mxCell>
        <mxCell id="c2a" value="&lt;b&gt;BreedRecognitionRepositoryImpl&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;сейчас: всегда «Labrador»&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;потом: TFLite (.tflite),&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Oxford-IIIT Pet Dataset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="464" y="540" width="228" height="230" as="geometry" /></mxCell>
        <mxCell id="c3p" value="&lt;b&gt;BreedDetailsFragment&lt;/b&gt;&lt;br&gt;&lt;b&gt;BreedDetailsViewModel&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;фото, темперамент, уход&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="736" y="132" width="228" height="110" as="geometry" /></mxCell>
        <mxCell id="c3d" value="&lt;b&gt;UseCase&lt;/b&gt;&lt;br&gt;GetBreedInfoUseCase&lt;br&gt;SaveEncounterUseCase&lt;br&gt;&lt;br&gt;&lt;b&gt;Entity&lt;/b&gt;&lt;br&gt;Breed · Encounter&lt;br&gt;&lt;br&gt;&lt;b&gt;Repository (интерфейсы)&lt;/b&gt;&lt;br&gt;BreedRepository&lt;br&gt;EncounterRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="736" y="258" width="228" height="250" as="geometry" /></mxCell>
        <mxCell id="c3a" value="&lt;b&gt;BreedRepositoryImpl&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;сейчас: тестовая порода&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;потом: Retrofit → thedogapi.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EncounterRepositoryImpl&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;потом: Room&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="736" y="540" width="228" height="230" as="geometry" /></mxCell>
