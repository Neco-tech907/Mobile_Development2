        <mxCell id="c1p" value="&lt;b&gt;AuthActivity / AuthFragment&lt;/b&gt;&lt;br&gt;&lt;b&gt;AuthViewModel&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;поля ввода, кнопки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="192" y="132" width="228" height="110" as="geometry" /></mxCell>
