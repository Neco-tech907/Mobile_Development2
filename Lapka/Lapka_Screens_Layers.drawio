        <mxCell id="lapka-screens_e8" value="сохранить встречу" style="endArrow=block;endFill=1;dashed=1;html=1;strokeWidth=1.3;strokeColor=#1D4ED8;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_breed" target="s_album"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
