  <diagram id="lapka-screens" name="Экраны">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="&lt;b&gt;Экраны приложения Lapka&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1100" height="36" as="geometry" /></mxCell>
        <mxCell id="zone" value="только авторизованный" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#1D4ED8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="396" y="292" width="268" height="155" as="geometry" /></mxCell>
        <mxCell id="s_auth" value="&lt;b&gt;Вход / Регистрация&lt;/b&gt;&lt;br&gt;AuthScreen&lt;br&gt;&lt;font color='#6B7280'&gt;Войти · Зарегистрироваться&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_recognize" value="&lt;b&gt;Распознать породу&lt;/b&gt;&lt;br&gt;RecognizeScreen&lt;br&gt;&lt;font color='#6B7280'&gt;камера / галерея · TFLite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_breed" value="&lt;b&gt;Карточка породы&lt;/b&gt;&lt;br&gt;BreedDetailsScreen&lt;br&gt;&lt;font color='#6B7280'&gt;фото · темперамент · уход&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_shelters" value="&lt;b&gt;Приюты и магазины&lt;/b&gt;&lt;br&gt;ShelterListScreen&lt;br&gt;&lt;font color='#6B7280'&gt;список с изображениями&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_details" value="&lt;b&gt;Страница приюта&lt;/b&gt;&lt;br&gt;ShelterDetailsScreen&lt;br&gt;&lt;font color='#6B7280'&gt;контакты · список питомцев&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_pet" value="&lt;b&gt;Карточка питомца&lt;/b&gt;&lt;br&gt;PetDetailsScreen&lt;br&gt;&lt;font color='#6B7280'&gt;кличка · возраст · описание&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1440" y="330" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_profile" value="&lt;b&gt;Профиль&lt;/b&gt;&lt;br&gt;ProfileScreen&lt;br&gt;&lt;font color='#6B7280'&gt;гость: войти · юзер: имя, выход&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="s_album" value="&lt;b&gt;Мой альбом встреч&lt;/b&gt;&lt;br&gt;AlbumScreen&lt;br&gt;&lt;font color='#6B7280'&gt;только авторизованный&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="api_breed" value="&lt;b&gt;TheDogAPI / TheCatAPI&lt;/b&gt;&lt;br&gt;«система» JSON API&lt;br&gt;&lt;font color='#6B7280'&gt;описание и фото пород&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;rounded=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="508" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="api_shelters" value="&lt;b&gt;Каталог приютов и питомцев&lt;/b&gt;&lt;br&gt;«система» JSON API (mockapi.io)&lt;br&gt;&lt;font color='#6B7280'&gt;приюты, магазины и их питомцы&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;rounded=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="508" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="lg1" value="белый — экран доступен гостю и авторизованному пользователю&lt;br&gt;голубой — экран только для авторизованного пользователя&lt;br&gt;серый «система» — внешний сервис, отдающий данные в формате JSON&lt;br&gt;пунктирная стрелка — необязательный переход или обращение к сервису" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="620" height="110" as="geometry" /></mxCell>
        <mxCell id="lapka-screens_e0" value="после входа" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#111827;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_auth" target="s_recognize"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lapka-screens_e1" value="распознал породу" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#111827;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_recognize" target="s_breed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lapka-screens_e2" value="где взять такую" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#111827;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_breed" target="s_shelters"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lapka-screens_e3" value="открыть приют" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#111827;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_shelters" target="s_details"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lapka-screens_e4" value="открыть питомца" style="endArrow=block;endFill=1;html=1;strokeWidth=1.4;strokeColor=#111827;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_details" target="s_pet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
