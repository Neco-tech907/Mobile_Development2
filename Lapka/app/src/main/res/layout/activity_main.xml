<?xml version="1.0" encoding="utf-8"?>
<!-- Временный экран-проверка слоёв, оформлен в палитре макета -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <include layout="@layout/view_ink_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonRecognize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_recognize" />

            <Button
                android:id="@+id/buttonShelters"
                style="@style/Widget.Lapka.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_shelters" />

            <!-- Список приютов (RecyclerView внутри ScrollView — прокрутку отдаём внешнему) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerShelters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <Button
                android:id="@+id/buttonPets"
                style="@style/Widget.Lapka.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_pets" />

            <!-- MediatorLiveData: приют из NetworkApi + отзывы из Room в одной карточке -->
            <Button
                android:id="@+id/buttonShelterDetails"
                style="@style/Widget.Lapka.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_shelter_details" />

            <TextView
                android:id="@+id/textViewShelter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_accent"
                android:padding="16dp"
                android:text="@string/main_shelter_hint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonSaveEncounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_save_encounter" />

            <Button
                android:id="@+id/buttonAlbum"
                style="@style/Widget.Lapka.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_album" />

            <Button
                android:id="@+id/buttonAddReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_add_review" />

            <Button
                android:id="@+id/buttonReviews"
                style="@style/Widget.Lapka.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_reviews" />

            <Button
                android:id="@+id/buttonProfile"
                style="@style/Widget.Lapka.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_profile" />

            <Button
                android:id="@+id/buttonAccount"
                style="@style/Widget.Lapka.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_logout" />

            <!-- Результат нажатия — в белой карточке с обводкой, как карточки макета -->
            <TextView
                android:id="@+id/textViewLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="@string/main_log_hint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
