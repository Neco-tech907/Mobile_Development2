<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка питомца по макету 09: фото, кличка, порода · возраст · пол, описание -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imagePet"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_photo_placeholder"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_paw_dark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Рыжик" />

        <TextView
            android:id="@+id/textPetInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            tools:text="Шпиц · 8 месяцев · мальчик" />

        <TextView
            android:id="@+id/textPetDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            tools:text="Активный щенок, привит, готов к переезду" />
    </LinearLayout>
</LinearLayout>
