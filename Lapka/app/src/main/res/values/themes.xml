<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Светлая тема по макету: у Лапки одна палитра и для дня, и для ночи -->
    <style name="Base.Theme.Lapka" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorAccentLight</item>
        <item name="colorOnPrimaryContainer">@color/colorTextPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextPrimary</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="materialButtonStyle">@style/Widget.Lapka.Button</item>
    </style>

    <style name="Theme.Lapka" parent="Base.Theme.Lapka" />

    <!-- Кнопки-пилюли высотой 52 dp, жирная подпись -->
    <style name="Widget.Lapka.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- «Создать аккаунт» — пшеничная кнопка -->
    <style name="Widget.Lapka.Button.Accent">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Второстепенная кнопка: белая с тёмной обводкой 1,5 px -->
    <style name="Widget.Lapka.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Поле ввода-пилюля с тёмной обводкой -->
    <style name="Widget.Lapka.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxStrokeColor">@color/colorOutline</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Надпись «Лапка» в шапке -->
    <style name="TextAppearance.Lapka.Wordmark" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
